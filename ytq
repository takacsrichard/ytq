#!/usr/bin/env python3
"""ytq — yt-dlp queue CLI.

ytq is a thin queue wrapper around yt-dlp: whatever you'd normally pass to
`yt-dlp` you pass to `ytq`, and it gets queued and run later by the daemon
with your args forwarded as-is (on top of ytq's own defaults — concurrency,
download archive, output template — which your args may override).

Usage:
  ytq <yt-dlp args...>        Queue a yt-dlp invocation, e.g.:
                                 ytq "https://youtu.be/XYZ"
                                 ytq "ytsearch1:some song" -f bestaudio
  ytq <file>                  Batch file: one job per line (each line is
                               split like a shell command, so lines may
                               include flags). Lines starting with # are
                               skipped.
  ytq list                    Show all queue items
  ytq status                  Show queue statistics
  ytq remove <id|substring> ...  Remove pending item(s) by ID or text match
  ytq retry                   Requeue all failed downloads
  ytq clear                   Remove all done/failed entries
  ytq errors                  Show failed items with error messages
  ytq watch                   Read invocations from stdin continuously (line by line)
"""

import json
import os
import shlex
import signal
import sqlite3
import sys
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent
DB_FILE  = BASE_DIR / "state" / "queue.db"
PID_FILE = BASE_DIR / "state" / "daemon.pid"

RESERVED = {"list", "status", "remove", "retry", "clear", "errors", "watch"}


# ── Helpers ────────────────────────────────────────────────────────────────────
def _conn() -> sqlite3.Connection:
    if not DB_FILE.exists():
        print(f"Error: queue DB not found at {DB_FILE}", file=sys.stderr)
        print("Start the daemon first: systemctl --user start ytdlp-ingest", file=sys.stderr)
        sys.exit(1)
    c = sqlite3.connect(DB_FILE, timeout=5)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA journal_mode=WAL")
    return c


def _notify_daemon():
    """Send SIGUSR1 to the daemon so it polls immediately."""
    try:
        pid = int(PID_FILE.read_text().strip())
        os.kill(pid, signal.SIGUSR1)
    except (FileNotFoundError, ValueError, ProcessLookupError):
        pass


def _display(args_json: str, width: int = 90) -> str:
    text = " ".join(json.loads(args_json))
    return text[:width] + ("…" if len(text) > width else "")


# ── Commands ───────────────────────────────────────────────────────────────────
def _jobs_from_args(args: list[str]) -> list[list[str]]:
    """A single bare file path is treated as a batch file: each non-empty,
    non-comment line becomes its own job (like yt-dlp's -a/--batch-file),
    split with shlex so a line may carry its own flags. Otherwise the whole
    argument list is one job, exactly as if you'd called yt-dlp directly."""
    if len(args) == 1 and not args[0].startswith("-") and Path(args[0]).is_file():
        jobs = []
        for line in Path(args[0]).read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#"):
                jobs.append(shlex.split(line))
        return jobs
    return [args]


def cmd_enqueue(args: list[str]):
    jobs = [j for j in _jobs_from_args(args) if j]
    if not jobs:
        print("No jobs to add.")
        return
    cwd = os.getcwd()
    c = _conn()
    added = skipped = 0
    for job in jobs:
        try:
            c.execute("INSERT INTO queue (args, cwd) VALUES (?, ?)", (json.dumps(job), cwd))
            added += 1
        except sqlite3.IntegrityError:
            skipped += 1
    c.commit()
    c.close()
    print(f"Added: {added}  Skipped (duplicate): {skipped}")
    if added:
        _notify_daemon()


def cmd_list():
    c = _conn()
    rows = c.execute(
        "SELECT id, status, added_at, args FROM queue ORDER BY id"
    ).fetchall()
    c.close()
    if not rows:
        print("Queue is empty.")
        return
    icons = {"pending": "⏳", "in_progress": "⬇ ", "done": "✅", "failed": "❌"}
    for r in rows:
        icon = icons.get(r["status"], "?")
        print(f"[{r['id']:4d}] {icon} {r['status']:<12}  {_display(r['args'])}")


def cmd_status():
    c = _conn()
    rows = c.execute("SELECT status, COUNT(*) n FROM queue GROUP BY status").fetchall()
    c.close()
    counts = {r["status"]: r["n"] for r in rows}
    total  = sum(counts.values())
    print(f"Total:        {total}")
    for s in ("pending", "in_progress", "done", "failed"):
        print(f"  {s:<13} {counts.get(s, 0)}")

    # Show daemon status
    if PID_FILE.exists():
        try:
            pid = int(PID_FILE.read_text().strip())
            os.kill(pid, 0)
            print(f"\nDaemon: running (PID {pid})")
        except (ProcessLookupError, PermissionError):
            print("\nDaemon: PID file stale (not running)")
    else:
        print("\nDaemon: not running")


def cmd_remove(identifiers: list[str]):
    c = _conn()
    removed = 0
    for ident in identifiers:
        ident = ident.strip()
        if not ident:
            continue
        if ident.isdigit():
            cur = c.execute(
                "DELETE FROM queue WHERE id=? AND status='pending'", (int(ident),)
            )
        else:
            cur = c.execute(
                "DELETE FROM queue WHERE args LIKE ? AND status='pending'",
                (f"%{ident}%",)
            )
        removed += cur.rowcount
    c.commit()
    c.close()
    print(f"Removed {removed} item(s)  (only 'pending' items can be removed)")


def cmd_retry():
    c = _conn()
    cur = c.execute(
        """UPDATE queue SET status='pending', error=NULL,
           started_at=NULL, finished_at=NULL, retry_count=retry_count+1
           WHERE status='failed'"""
    )
    c.commit()
    c.close()
    n = cur.rowcount
    print(f"Requeued {n} failed item(s)")
    if n:
        _notify_daemon()


def cmd_clear():
    c = _conn()
    cur = c.execute("DELETE FROM queue WHERE status IN ('done', 'failed')")
    c.commit()
    c.close()
    print(f"Cleared {cur.rowcount} completed/failed item(s)")


def cmd_errors():
    c = _conn()
    rows = c.execute(
        "SELECT id, args, error FROM queue WHERE status='failed' ORDER BY id"
    ).fetchall()
    c.close()
    if not rows:
        print("No failed downloads.")
        return
    for r in rows:
        print(f"\n[{r['id']}] {_display(r['args'])}")
        if r["error"]:
            print(f"       {r['error'][:300]}")


def cmd_watch():
    """Read yt-dlp invocations line-by-line from stdin, add each immediately."""
    print("Watching stdin for yt-dlp invocations (Ctrl-D or Ctrl-C to stop)…", file=sys.stderr)
    try:
        for line in sys.stdin:
            line = line.strip()
            if line:
                cmd_enqueue(shlex.split(line))
    except KeyboardInterrupt:
        print("\nStopped watching.", file=sys.stderr)


# ── Entry point ───────────────────────────────────────────────────────────────
USAGE = __doc__

def main():
    args = sys.argv[1:]
    if not args:
        print(USAGE)
        sys.exit(0)

    cmd  = args[0]
    rest = args[1:]

    if cmd not in RESERVED:
        # Bare passthrough: the whole argv is a yt-dlp invocation to enqueue.
        cmd_enqueue(args)
        return

    if cmd == "list":
        cmd_list()
    elif cmd == "status":
        cmd_status()
    elif cmd == "remove":
        if not rest:
            print("Error: specify ID or text to match for removal.", file=sys.stderr)
            sys.exit(1)
        cmd_remove(rest)
    elif cmd == "retry":
        cmd_retry()
    elif cmd == "clear":
        cmd_clear()
    elif cmd == "errors":
        cmd_errors()
    elif cmd == "watch":
        cmd_watch()


if __name__ == "__main__":
    main()
